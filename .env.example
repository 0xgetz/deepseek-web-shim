# Copy to .env and fill in. Never commit .env (it is gitignored).

# Key clients must present to this shim (Authorization: Bearer <key>).
# Leave unset to run with no auth on localhost only.
DSW_API_KEY=

# Bind address
DSW_HOST=127.0.0.1
DSW_PORT=8712

# Where the captured session lives (default: ~/.deepseek-web-shim)
DSW_STATE_DIR=

# DeepSeek bearer token captured from YOUR OWN logged-in browser session.
# Preferred: run `deepseek-web-shim --session <file>` instead of putting it here.
DS_TOKEN=

# Outbound leg through a residential proxy, if your host's IP is refused.
# DS_PROXY=http://user:pass@host:port

# Optional speed backend: DeepSeek's wasm module, if you fetched it
# (scripts/fetch_wasm.py). Without it the pure-Python PoW runs, same result.
# DSW_WASM=wasm/sha3_wasm_bg.wasm
